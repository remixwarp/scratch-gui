# Mac OS
.DS_Store

# NPM
# 忽略任意层级的 node_modules（不只根目录），避免临时安装的依赖被提交
**/node_modules/
node_modules/
npm-*
*.zip

# 本地临时目录（排查/临时安装用）
/.tmp-test

# Environment variables
.env
.env.local
.env.*.local

# Testing
/.nyc_output
/coverage

# Build
/build
/dist
/.opt-in

# Webpack filesystem build cache
/.webpack-cache

# Generated translation files
/translations
/locale

# Other generated source
# /src/generated - NOT ignored, contains microbit-hex-url.cjs

# Downloaded during "npm install"
# /static/microbit - NOT ignored, contains scratch-microbit hex file
/static/penguinmod

# for act
.secrets

# Dev server log
dev-server.log
devserver.log
devserver*.log
