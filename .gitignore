# Mac OS
.DS_Store

# NPM
# 忽略任意层级的 node_modules（不只根目录），避免临时安装的依赖被提交
**/node_modules/
node_modules/
npm-*
*.zip

# 本地临时目录（排查/临时安装用）
/.tmp-test
/.tmp-*/

# Environment variables
.env
.env.local
.env.*.local

# Testing
/.nyc_output
/coverage

# Build
/build
/dist
/.opt-in

# Webpack filesystem build cache
/.webpack-cache

# Generated translation files
/translations
/locale

# Other generated source
# /src/generated - NOT ignored, contains microbit-hex-url.cjs

# Downloaded during "npm install"
# /static/microbit - NOT ignored, contains scratch-microbit hex file
/static/penguinmod

# for act
.secrets

# Dev server log
dev-server.log
devserver.log
devserver*.log

# Bun lock 文件：提交 bun.lock（文本），CF Pages 靠它才能识别出包管理器是 bun。
# 一旦检测不到，CF 会回退到 `npm install --progress=false`，而 npm 会为 git 依赖
# scratch-render#develop 安装 devDependencies 并触发 playwright-chromium 下载浏览器
# （playwright.download.prss.microsoft.com 在 CF 环境 DNS 被墙），导致构建失败。
# 只忽略旧的二进制锁文件 bun.lockb。
bun.lockb
